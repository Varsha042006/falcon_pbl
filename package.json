{
  "name": "falcon-pbl-project-hub",
  "version": "4.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed-v2.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:upgrade-v3": "tsx --env-file=.env scripts/migrate.ts",
    "db:upgrade-v4": "tsx --env-file=.env scripts/migrate.ts",
    "db:upgrade-v4.1": "tsx --env-file=.env scripts/migrate.ts",
    "db:reset-testing-v4.1": "tsx --env-file=.env scripts/reset-testing-data-v4-1.ts",
    "db:prepare-production-v4.1": "tsx --env-file=.env scripts/reset-testing-data-v4-1.ts && tsx --env-file=.env scripts/seed-v2.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "16.2.10",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.12",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
